#!/bin/bash
#
# backup.mysql - Backup MariaDB databases
#
# (c) 2011-2025 Gerrit Beine
#
umask 022

if [ -z ${daily_backup_running} ]; then
	echo "$0 not called from within backup script"
	exit
fi

if [ -r /etc/backup/mariadb ]; then
	. /etc/backup/mariadb
fi

: ${daily_backup_mariadb_enable="NO"}
: ${daily_backup_mariadb_compress="YES"}
: ${daily_backup_mariadb_backup_dir="/var/backups/mariadb"}
: ${daily_backup_mariadb_host="localhost"}
: ${daily_backup_mariadb_user="_backup_"}
: ${daily_backup_mariadb_pass="pass mysql/_backup_"}
: ${daily_backup_mariadb_replication="NO"}
: ${daily_backup_mariadb_ignore_databases="information_schema performance_schema sys"}
: ${daily_backup_mariadb_keep_days="-14days"}
: ${daily_backup_mariadb_dump_options=""}
: ${daily_backup_mariadb_podman_container="mariadb"}

mariadb_admin="podman exec ${daily_backup_mariadb_podman_container} mariadb-admin"
mariadb_show="podman exec ${daily_backup_mariadb_podman_container} mariadb-show"
mariadb_show_options="--host=${daily_backup_mariadb_host}"
mariadb_dump="podman exec ${daily_backup_mariadb_podman_container} mariadb-dump"
mariadb_dump_options="--host=${daily_backup_mariadb_host} --flush-logs --add-locks --lock-tables --triggers --routines --events ${daily_backup_mariadb_dump_options}"
find="/usr/bin/find"
find_cleanup_options="-type f -not -newermt ${daily_backup_mariadb_keep_days} -delete"
xz="/usr/bin/xz"
xz_options=""

today=`date +%Y%m%d`

rc=0
case "${daily_backup_mariadb_enable}" in
	[Yy][Ee][Ss])
		echo
		echo "Backup MariaDB databases"
		export MARIADB_PASSWORD=`${daily_backup_mariadb_pass}`

		mkdir -p ${daily_backup_mariadb_backup_dir} || true

		case "${daily_backup_mariadb_replication}" in
			[Yy][Ee][Ss])
				${mariadb_admin} stop --user=${daily_backup_mariadb_user} --password=${MARIADB_PASSWORD}
				;;
		esac

		for db in `${mariadb_show} --user=${daily_backup_mariadb_user} --password=${MARIADB_PASSWORD} ${mariadb_show_options} | sed -e '/^\+.*\+$/d' | awk '{print $2}'`; do
			if [[ "Databases" == "${db}" ]]; then
				continue
			fi
			if [[ " ${daily_backup_mariadb_ignore_databases[@]} " =~ " ${db} " ]]; then
				continue
			fi
			${mariadb_dump} --user=${daily_backup_mariadb_user} --password=${MARIADB_PASSWORD} ${mariadb_dump_options} ${db} > ${daily_backup_mariadb_backup_dir}/${db}-${today}.sql
			${xz} ${xz_options} ${daily_backup_mariadb_backup_dir}/${db}-${today}.sql
		done

		${find} ${daily_backup_mariadb_backup_dir} ${find_cleanup_options}

		case "${daily_backup_mariadb_replication}" in
			[Yy][Ee][Ss])
				${mariadb_admin} start --user=${daily_backup_mariadb_user} --password=${MARIADB_PASSWORD}
				;;
		esac
		;;
esac

exit "${rc}"
