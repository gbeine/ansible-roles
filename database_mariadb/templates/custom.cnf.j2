#
# {{ ansible_managed }}
#
# Read by mariadbd-safe with --defaults-extra-file=/config/custom.cnf,
# the options of the role first, then the options of mariadb_config
#
{% for section in database_mariadb__config_sections
     if section in database_mariadb__config_role or (database_mariadb__config[section] | default({}) | length > 0) %}

[{{ section }}]
{%   for option, value in (database_mariadb__config_role[section] | default({})).items() %}
{{ option }} = {{ value }}
{%   endfor %}
{%   for option, value in (database_mariadb__config[section] | default({})).items() if value is not none and value is not sameas false %}
{%     for item in (value if value is sequence and value is not string else [ value ]) %}
{{ option if item is sameas true else option ~ ' = ' ~ item }}
{%     endfor %}
{%   endfor %}
{% endfor %}
