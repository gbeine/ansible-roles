// {{ ansible_managed }}
//
// Generated from nodered_config, see https://nodered.org/docs/user-guide/runtime/configuration

const fs = require('fs');

// Options set to null are removed, Node-RED uses its default then
function removeNull(options) {
    for (const key of Object.keys(options)) {
        if (options[key] === null) {
            delete options[key];
        } else if (typeof options[key] === 'object' && !Array.isArray(options[key])) {
            removeNull(options[key]);
        }
    }
    return options;
}

const settings = removeNull({{ app_nodered__config | to_nice_json(indent=4) }});
{% if app_nodered__secret_paths.credentialSecret is defined %}

// The key of the credentials, read from the podman secret
settings.credentialSecret = fs.readFileSync({{ app_nodered__secret_paths.credentialSecret | to_json }}, 'utf8');
{% endif %}
{% if app_nodered__users_result.users | default([]) | length > 0 %}

// The users of the editor with the bcrypt hashes of their passwords
settings.adminAuth = {
    type: 'credentials',
    users: {{ app_nodered__users_result.users | to_nice_json(indent=4) | indent(4) }}
};
{% endif %}

module.exports = settings;
