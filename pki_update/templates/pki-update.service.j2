### {{ ansible_managed }}
###

[Unit]
Description=Restart %i after the renewal of its certificate

[Service]
Type=oneshot
# Restart only a running service whose certificate is newer than its start, a missing certificate fails the unit.
# $$ passes $ to the shell, %% passes %.
ExecCondition=/usr/bin/sh -c '\
  systemctl is-active --quiet "$$PKI_SERVICE" || exit 1; \
  CERT=$$(stat -L -c %%Y "$$PKI_CERTIFICATE") || exit 255; \
  STARTED=$$(systemctl show --timestamp=unix --property=ActiveEnterTimestamp --value "$$PKI_SERVICE"); \
  [ "$$CERT" -gt "$${STARTED#@}" ]'
ExecStart=/usr/bin/systemctl restart ${PKI_SERVICE}
