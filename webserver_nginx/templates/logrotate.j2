{{ webserver_nginx__podman_log_dir }}/*.log {
        daily
        missingok
        rotate 14
        compress
        delaycompress
        notifempty
        create 0640 root root
        sharedscripts
        postrotate
                /usr/bin/podman exec {{ webserver_nginx__podman_name }} bash -c 'kill -USR1 $(cat /var/run/nginx.pid)'
        endscript
}
