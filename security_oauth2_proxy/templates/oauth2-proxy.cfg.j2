# {{ ansible_managed }}
{% for key, value in security_oauth2_proxy__config | combine(security_oauth2_proxy__config_role) | dictsort if value is not none %}
{%   if value is boolean %}
{{ key }} = {{ value | string | lower }}
{%   elif value is number %}
{{ key }} = {{ value }}
{%   elif value is string %}
{{ key }} = {{ value | to_json }}
{%   else %}
{{ key }} = {{ value | map('string') | list | to_json }}
{%   endif %}
{% endfor %}
