/*
 *
 * {{ ansible_managed }}
 *
 */

object CheckCommand "printer_snmp" {
    import "ipv4-or-ipv6"
    command = [ PluginLocalDir + "/check_printer_snmp.py" ]

    arguments = {
        "-H" = "$printer_address$"
        "-C" = "$printer_community$"
        "-v" = "$printer_snmp_version$"
        "-t" = "$printer_timeout$"
        "--check" = {
            value = "$printer_check$"
            required = true
        }
        "--toner" = { value = "$printer_toner$", set_if = "$printer_toner$" }
        "-w" = "$printer_warning$"
        "-c" = "$printer_critical$"
        "--status-critical" = { value = "$printer_status_critical$", set_if = "$printer_status_critical$" }
        "--status-ignore" = { value = "$printer_status_ignore$", set_if = "$printer_status_ignore$" }
    }

    vars.printer_address = "$check_address$"
    vars.printer_community = "public"
    vars.printer_snmp_version = "2c"
    vars.printer_timeout = 5
    vars.printer_warning = 10
    vars.printer_critical = 5
}
