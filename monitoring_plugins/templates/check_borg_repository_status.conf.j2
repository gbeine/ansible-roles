/*
 *
 * {{ ansible_managed }}
 *
 */

object CheckCommand "borg-repository-status" {
	command = [ "sudo", PluginLocalDir + "/check_borg_repository_status" ]

	arguments = {
		"-w" = {
			value = "$borg_repository_status_warning$"
			description = "WARNING when the newest archive is older (hours)."
		}
		"-c" = {
			value = "$borg_repository_status_critical$"
			description = "CRITICAL when the newest archive is older (hours)."
		}
	}

	vars.borg_repository_status_warning = 36
	vars.borg_repository_status_critical = 72
}
