/*
 *
 * {{ ansible_managed }}
 *
 */

object CheckCommand "borg-repository-status" {
	command = [ "sudo", PluginLocalDir + "/check_borg_repository_status" ]

	arguments = {
		"-w" = {
			value = "$borg_repository_status_warning$"
			description = "WARNING when the newest archive is older (hours). Default: 36"
		}
		"-c" = {
			value = "$borg_repository_status_critical$"
			description = "CRITICAL when the newest archive is older (hours). Default: 72"
		}
	}

	vars.borg_repository_status_warning = {{ monitoring_plugins__check_borg_repository_status_warning }}
	vars.borg_repository_status_critical = {{ monitoring_plugins__check_borg_repository_status_critical }}
}
