/*
 *
 * {{ ansible_managed }}
 *
 */

object CheckCommand "sudo-smartpl" {
	command = [ "sudo", PluginDir + "/check_smart.pl" ]

	arguments = {
	    "-d" = {
	        value = "$smart_device$"
	        description = "Name of a local hard drive to monitor"
	        required = true
	    }
	    "-i" = {
	        value = "$smart_interface$"
	        description = "device's interface type"
	        required = true
	    }
	}

    vars.smart_interface = "auto"
}
