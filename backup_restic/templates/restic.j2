###
### {{ ansible_managed }}
###

daily_backup_restic_enable="YES"
daily_backup_restic_pass_enable="{{ backup_restic__pass_enable | ternary('YES', 'NO')}}"
{% if backup_restic__pass_command | default('') | length > 0 %}
daily_backup_restic_pass_command="{{ backup_restic__pass_command }}"
{% endif %}
daily_backup_restic_repository="{{ backup_restic__repository }}"
{% if backup_restic__password_command | default('') | length > 0 %}
daily_backup_restic_password_command="{{ backup_restic__password_command }}"
{% endif %}
{% if backup_restic__cache_dir | default('') | length > 0 %}
daily_backup_restic_cache_dir="{{ backup_restic__cache_dir }}"
{% endif %}
{% if backup_restic__ssh %}
daily_backup_restic_backend="SSH"
daily_backup_restic_sftp_command="{{ backup_restic__sftp_command }}"
{% elif backup_restic__rest %}
daily_backup_restic_backend="REST"
{% endif %}
{% if backup_restic__options | default('') | length > 0 %}
daily_backup_restic_options="{{ backup_restic__options }}"
{% endif %}
{% if backup_restic__exclude | default([]) | length > 0 %}
daily_backup_restic_exclude="{{ backup_restic__exclude | join(' ') }}"
{% endif %}
