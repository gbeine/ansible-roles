###
### {{ ansible_managed }}
###

daily_backup_restic_enable="YES"
daily_backup_restic_repository="{{ backup_restic__repository }}"
daily_backup_restic_password="{{ backup_restic__password }}"
{% if backup_restic__cache_dir | length > 0 %}
daily_backup_restic_cache_dir="{{ backup_restic__cache_dir }}"
{% endif %}
daily_backup_restic_ssh="{{ backup_restic__ssh | ternary('YES', 'NO') }}"
{% if backup_restic__ssh %}
daily_backup_restic_sftp_command="{{ backup_restic__sftp_command }}"
{% endif %}
daily_backup_restic_options="{{ backup_restic__options }}"
{% if backup_restic__exclude | length > 0 %}
daily_backup_restic_exclude="{{ backup_restic__exclude | join(' ') }}"
{% endif %}
