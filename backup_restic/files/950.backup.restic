#!/bin/bash
#
# restic - Run restic backup
#
# (c) 2017 Gerrit Beine
#
umask 022

if [ -z ${daily_backup_running} ]; then
	echo "$0 not called from within backup script"
	exit
fi

if [ -r /etc/backup/restic ]; then
	. /etc/backup/restic
fi

: ${daily_backup_restic_enable="NO"}
: ${daily_backup_restic_pass_enable="NO"}
: ${daily_backup_restic_pass_command="pass"}
: ${daily_backup_restic_repository="backup"}
: ${daily_backup_restic_backend=""}
: ${daily_backup_restic_sftp_command="ssh -F /etc/backup/restic-ssh backup -s sftp"}
: ${daily_backup_restic_cache_dir=""}
: ${daily_backup_restic_options="--compression max --one-file-system"}
: ${daily_backup_restic_exclude=""}
: ${daily_backup_restic_include="/etc/backup/restic-directories"}

restic="/usr/bin/restic"
restic_options="${daily_backup_restic_options} ${daily_backup_restic_exclude}"

rc=0
case "${daily_backup_restic_enable}" in
	[Yy][Ee][Ss])
		echo
		echo "Running restic backup"
		export RESTIC_REPOSITORY=${daily_backup_restic_repository}
		case "${daily_backup_restic_pass_enable}" in
			[Yy][Ee][Ss])
				export RESTIC_PASSWORD_COMMAND="${daily_backup_restic_pass_command} restic/password"
				case "${daily_backup_restic_backend}" in
					[Rr][Ee][Ss][Tt])
						export RESTIC_REST_USERNAME=`${daily_backup_restic_pass_command} restic/rest_username |tr -d '\r'`
						export RESTIC_REST_PASSWORD=`${daily_backup_restic_pass_command} restic/rest_password |tr -d '\r'`
						;;
				esac
				;;
		esac
		[ -n "${daily_backup_restic_cache_dir}" ] && export RESTIC_CACHE_DIR=${daily_backup_restic_cache_dir}
		case "${daily_backup_restic_backend}" in
			[Rr][Cc][Ll][Oo][Nn][Ee])
				echo "rclone backened is not yet supported"
				# ${restic} backup ${restic_options} --files-from-verbatim ${daily_backup_restic_include}
				;;
			[Ss][Ss][Hh])
				${restic} backup ${restic_options} -o sftp.command="${daily_backup_restic_sftp_command}" --files-from-verbatim ${daily_backup_restic_include}
				;;
# rest backend requires no special treatment here
# 			[Rr][Ee][Ss][Tt])
			*)
				${restic} backup ${restic_options} --files-from-verbatim ${daily_backup_restic_include}
				;;
		esac
		;;
esac

exit "${rc}"
