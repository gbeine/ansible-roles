###
### {{ ansible_managed }}
###
{% for clause, value in dns_unbound__config | dictsort if value is not none %}
{%   for options in (value if value is sequence and value is not mapping and value is not string else [ value ]) %}
{{ clause }}:
{%     for option, setting in ([ ('name', options['name']) ] if 'name' in options else []) + (options | dictsort | rejectattr('0', 'eq', 'name') | list) if setting is not none %}
{%       for item in (setting if setting is sequence and setting is not string else [ setting ]) %}
    {{ option }}: {{ 'yes' if item is sameas true else ('no' if item is sameas false else item) }}
{%       endfor %}
{%     endfor %}
{%   endfor %}
{% endfor %}
