#
# {{ lookup('ansible.builtin.config', 'DEFAULT_MANAGED_STR') }}
#
[Unit]
Description=Watch the certificate of pki_certbot for strongSwan

[Path]
# certbot replaces the symlinks of the directory after a renewal, a watch on cert.pem
# would follow the symlink to the former file in archive/, which never changes
PathChanged={{ security_strongswan__certificate_merged.home }}/etc/live/{{ security_strongswan__certificate_merged.realm }}
Unit={{ security_strongswan__debian_deploy_unit }}.service

[Install]
WantedBy=multi-user.target
