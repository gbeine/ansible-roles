#!/bin/sh
#
# {{ lookup('ansible.builtin.config', 'DEFAULT_MANAGED_STR') }}
#
# Copies the certificate of {{ security_strongswan__certificate_merged.domain }} of acme to swanctl and loads it,
# acme calls the hotplug scripts with ACTION issued and renewed
umask 077

case "${ACTION}" in
    issued|renewed) ;;
    *) exit 0 ;;
esac

acme='{{ security_strongswan__openwrt_acme_dir }}/{{ security_strongswan__certificate_merged.domain }}'

cp -L "${acme}.crt" '{{ security_strongswan__cert_file }}' && chmod 0644 '{{ security_strongswan__cert_file }}'
cp -L "${acme}.chain.crt" '{{ security_strongswan__chain_file }}' && chmod 0644 '{{ security_strongswan__chain_file }}'
cp -L "${acme}.key" '{{ security_strongswan__key_file }}' && chmod 0600 '{{ security_strongswan__key_file }}'

swanctl --load-creds --noprompt >/dev/null 2>&1 || logger -t strongswan 'swanctl --load-creds failed after the renewal of the certificate'
