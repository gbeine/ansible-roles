{% macro value(item) -%}
{%- if item is boolean -%}{{ 'yes' if item else 'no' }}
{%- elif item is sequence and item is not string -%}{{ item | map('string') | join(', ') }}
{%- else -%}{{ item }}{%- endif -%}
{%- endmacro %}
{% macro section(data, indent) %}
{% for key, item in data.items() if item is not none %}
{% if item is mapping %}
{{ indent }}{{ key }} {
{{ section(item, indent ~ '    ') }}{{ indent }}}
{% else %}
{{ indent }}{{ key }} = {{ value(item) }}
{% endif %}
{% endfor %}
{% endmacro %}

