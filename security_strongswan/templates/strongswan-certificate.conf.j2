#
# Ansible managed
#
# Copies the certificate of the realm {{ security_strongswan__certificate_merged.realm }} ({{ 'pki_easyrsa_deploy' if security_strongswan__certificate_merged.source == 'realm' else 'pki_certbot' }}) to swanctl
# at every start, charon loads it with swanctl --load-all afterwards, pki_update restarts strongSwan after a renewal
[Service]
{% for file in security_strongswan__start_files %}
ExecStartPre=/usr/bin/install -o root -g root -m {{ file.mode }} {{ file.src }} {{ file.dest }}
{% endfor %}
