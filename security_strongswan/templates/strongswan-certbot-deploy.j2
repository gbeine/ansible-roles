#!/bin/sh
#
# {{ lookup('ansible.builtin.config', 'DEFAULT_MANAGED_STR') }}
#
# Copies the certificate of the realm {{ security_strongswan__certificate_merged.realm }} of pki_certbot to swanctl and loads it,
# started by {{ security_strongswan__debian_deploy_unit }}.path after a renewal
set -eu

live='{{ security_strongswan__certificate_merged.home }}/etc/live/{{ security_strongswan__certificate_merged.realm }}'

# certbot replaces the symlinks one after another and the first one starts this service,
# wait until the certificate and the key belong together
sleep 5

install -o root -g root -m 0644 "${live}/cert.pem" '{{ security_strongswan__cert_file }}'
install -o root -g root -m 0644 "${live}/chain.pem" '{{ security_strongswan__chain_file }}'
install -o root -g root -m 0600 "${live}/privkey.pem" '{{ security_strongswan__key_file }}'

if systemctl --quiet is-active '{{ security_strongswan__debian_service }}'; then
    swanctl --load-creds --noprompt
fi
