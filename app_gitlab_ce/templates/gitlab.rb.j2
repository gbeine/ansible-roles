#
# {{ ansible_managed }}
#
# The options of gitlab_config, see files/gitlab-config-template/gitlab.rb.template of omnibus-gitlab,
# the passwords are read from the files of gitlab_secrets
#
{#- Writes a value as Ruby literal: strings in single quotes, null as nil, dictionaries as hashes with string keys #}
{%- macro ruby(value) -%}
{%-   if value is none -%}nil
{%-   elif value is boolean -%}{{ 'true' if value else 'false' }}
{%-   elif value is number -%}{{ value }}
{%-   elif value is mapping -%}{ {% for key, item in value.items() %}'{{ key | string | replace('\\', '\\\\') | replace("'", "\\'") }}' => {{ ruby(item) }}{{ ', ' if not loop.last }}{% endfor %} }
{%-   elif value is sequence and value is not string -%}[{% for item in value %}{{ ruby(item) }}{{ ', ' if not loop.last }}{% endfor %}]
{%-   else -%}'{{ value | string | replace('\\', '\\\\') | replace("'", "\\'") }}'
{%-   endif -%}
{%- endmacro -%}
{#- Writes the keys of a dictionary below a section one by one, e.g. gitlab_rails['object_store']['enabled'] #}
{%- macro assign(prefix, value) -%}
{%-   if value is mapping and value | length > 0 -%}
{%-     for key, item in value.items() -%}
{{ assign(prefix ~ "['" ~ (key | string | replace('\\', '\\\\') | replace("'", "\\'")) ~ "']", item) }}
{%-     endfor -%}
{%-   else -%}
{{ prefix }} = {{ ruby(value) }}
{% endif -%}
{%- endmacro %}

{% for setting, value in app_gitlab_ce__config.items() if value is not mapping %}
{{ setting }} {{ ruby(value) }}
{% endfor %}
{% for attribute, options in app_gitlab_ce__config.items() if options is mapping %}

{%   for key, value in options.items() %}
{%     if (attribute ~ '.' ~ key) in app_gitlab_ce__config_sections and value is mapping %}
{{ assign(attribute ~ "['" ~ key ~ "']", value) -}}
{%     else %}
{{ attribute }}['{{ key }}'] = {{ ruby(value) }}
{%     endif %}
{%   endfor %}
{% endfor %}
{% if app_gitlab_ce__secrets_valid | length > 0 %}

{% for secret in app_gitlab_ce__secrets_valid %}
{{ secret.target.split('.') | first }}{% for key in secret.target.split('.')[1:] %}['{{ key }}']{% endfor %} = File.read('{{ app_gitlab_ce__secrets_dir }}/{{ secret.name }}').chomp
{% endfor %}
{% endif %}
