#
# {{ ansible_managed }}
#
# Dependencies of snmpd on other units, see systemd.unit(5)
#

[Unit]
{% for key, directive in monitoring_snmp__unit_directives.items() if key != 'after' and monitoring_snmp__unit[key] | default([]) | length > 0 %}
{{ directive }}={{ monitoring_snmp__unit[key] | join(' ') }}
{% endfor %}
# snmpd starts after all units it depends on
After={{ monitoring_snmp__unit.values() | flatten | unique | join(' ') }}
