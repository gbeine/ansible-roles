{% macro directive(name, v) -%}
{%   set values = v if (v is iterable and v is not string and v is not mapping) else [v] %}
{%   for value in values if value | string | length > 0 %}
{{ name }} {{ value }}
{%   else %}
#{{ name }}
{%   endfor %}
{%- endmacro %}
#
# {{ ansible_managed }}
#
# snmpd of Net-SNMP {{ monitoring_snmp__release }}, see snmpd.conf(5)
#
{% for section in monitoring_snmp__release_sections %}

###########################################################################
# SECTION: {{ section.name }}
#
{%   for line in section.description.splitlines() %}
#   {{ line }}
{%   endfor %}
{%   for setting in section.settings %}

{%     for line in setting.description.splitlines() %}
# {{ line }}
{%     endfor %}
{{ directive(setting.name, monitoring_snmp__config.get(setting.name, setting.default)) }}
{%-   endfor %}
{% endfor %}
{% set known = monitoring_snmp__release_sections | map(attribute='settings') | flatten | map(attribute='name') | list %}
{% set additional = monitoring_snmp__config.keys() | reject('in', known) | list %}
{% if additional | length > 0 %}

###########################################################################
# Additional settings
#
{%   for name in additional %}
{{ directive(name, monitoring_snmp__config[name]) }}
{%-  endfor %}
{% endif %}

# include a all *.conf files in a directory
includeDir {{ monitoring_snmp__conf_d_dir }}
