{#- false or null removes a directive, true writes it without a value, a list writes one line per value #}
{% macro directive(name, v) -%}
{%   set values = [] if (v is none or v is sameas false) else (v if (v is iterable and v is not string) else [v]) %}
{%   for value in values %}
{{ name }}{{ '' if value is sameas true else ' ' ~ value }}
{%   else %}
#{{ name }}
{%   endfor %}
{%- endmacro %}
#
# {{ ansible_managed }}
#
# {{ item.name }}, included by {{ monitoring_snmp__etc_dir }}/snmpd.conf
#

{% for name, v in item.settings.items() %}
{{ directive(name, v) }}
{%- endfor %}
