{% macro directive(name, v) -%}
{%   set values = v if (v is iterable and v is not string and v is not mapping) else [v] %}
{%   for value in values if value | string | length > 0 %}
{{ name }} {{ value }}
{%   else %}
#{{ name }}
{%   endfor %}
{%- endmacro %}
#
# {{ ansible_managed }}
#
# {{ item.name }}, included by {{ monitoring_snmp__etc_dir }}/snmpd.conf
#

{% for name, v in item.settings.items() %}
{{ directive(name, v) }}
{%- endfor %}
