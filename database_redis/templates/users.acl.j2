###
### {{ ansible_managed }}
###

# The passwords are stored as SHA-256, the users are reset before their rules
{% if database_redis__users | selectattr('name', 'eq', 'default') | list | length == 0 %}
{{ database_redis__acl_default }}
{% endif %}
{% for user in database_redis__users %}
{%   set password = ('#' ~ (database_redis__passwords[user.name] | string | hash('sha256'))) if user.name in database_redis__passwords else 'nopass' %}
user {{ user.name }} reset {{ (user.rules | default([]) + [ 'on' if user.enabled | default(true) else 'off', password ]) | join(' ') }}
{% endfor %}
