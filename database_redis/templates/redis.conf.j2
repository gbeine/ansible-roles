###
### {{ ansible_managed }}
###

# Set by the role
{% for option, value in database_redis__config_role.items() %}
{{ option }} {{ value }}
{% endfor %}

# Set with redis_config
{% for option, value in database_redis__config.items() if value is not none and value is not sameas false %}
{%   for item in (value if value is sequence and value is not string else [ value ]) %}
{{ option }} {{ '""' if item | string | length == 0 else item }}
{%   endfor %}
{% endfor %}
{% if database_redis__secrets | length > 0 %}

# The secrets of redis_secrets
{%   for secret in database_redis__secrets %}
include {{ database_redis__secrets_dir }}/{{ secret.name }}
{%   endfor %}
{% endif %}
