#
# {{ ansible_managed }}
#

{% if monitoring_icinga_agent__systemd_unit | length > 0 %}
[Unit]
{% for key, directive in monitoring_icinga_agent__systemd_unit_directives.items() if monitoring_icinga_agent__systemd_unit[key] is defined %}
{{ directive }}={{ monitoring_icinga_agent__systemd_unit[key] | join(' ') }}
{% endfor %}

{% endif %}
[Service]
# install follows the links of the source, a renewed certificate is used after the next restart
ExecStartPre=/usr/bin/install -o {{ monitoring_icinga_agent__user }} -g {{ monitoring_icinga_agent__group }} -m 0644 {{ monitoring_icinga_agent__cert_source_ca_file }} {{ monitoring_icinga_agent__cert_dir }}/ca.crt
ExecStartPre=/usr/bin/install -o {{ monitoring_icinga_agent__user }} -g {{ monitoring_icinga_agent__group }} -m 0644 {{ monitoring_icinga_agent__cert_source_cert_file }} {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.crt
ExecStartPre=/usr/bin/install -o {{ monitoring_icinga_agent__user }} -g {{ monitoring_icinga_agent__group }} -m 0400 {{ monitoring_icinga_agent__cert_source_key_file }} {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.key
