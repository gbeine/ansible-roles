#
# {{ ansible_managed }}
#

[Service]
ExecStartPre=/usr/bin/cp -uL {{ monitoring_icinga_agent__cert_source_ca_file }} {{ monitoring_icinga_agent__cert_dir }}/ca.crt
ExecStartPre=/usr/bin/cp -uL {{ monitoring_icinga_agent__cert_source_cert_file }} {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.crt
ExecStartPre=/usr/bin/cp -uL {{ monitoring_icinga_agent__cert_source_key_file }} {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.key
ExecStartPre=/usr/bin/chown {{ monitoring_icinga_agent__user }}:{{ monitoring_icinga_agent__group }} {{ monitoring_icinga_agent__cert_dir }}/ca.crt {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.crt {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.key
ExecStartPre=/usr/bin/chmod 0400 {{ monitoring_icinga_agent__cert_dir }}/{{ monitoring_icinga_agent__node_name }}.key
