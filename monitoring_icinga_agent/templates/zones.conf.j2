/*
 *
 * {{ ansible_managed }}
 *
 */

object Endpoint "{{ monitoring_icinga_agent__parent_name }}" {
{% if monitoring_icinga_agent__parent_host | length > 0 %}
  host = "{{ monitoring_icinga_agent__parent_host }}"
  port = {{ monitoring_icinga_agent__parent_port }}
{% else %}
  // The parent connects to the agent, set icinga_parent_host to connect to the parent
{% endif %}
}

object Zone "{{ monitoring_icinga_agent__zone_name }}" {
  endpoints = [ "{{ monitoring_icinga_agent__parent_name }}" ]
}

object Endpoint "{{ monitoring_icinga_agent__node_name }}" {
}

object Zone "{{ monitoring_icinga_agent__node_name }}" {
  endpoints = [ "{{ monitoring_icinga_agent__node_name }}" ]
  parent = "{{ monitoring_icinga_agent__zone_name }}"
}

object Zone "global-templates" {
  global = true
}

object Zone "director-global" {
  global = true
}
