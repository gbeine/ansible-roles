# {{ ansible_managed }}
{% for key, value in security_openssh__config | dictsort if value is not none %}
{%   for item in (value if (value is sequence and value is not string) else [ value ]) %}
{%     if item is boolean %}
{{ key }} {{ 'yes' if item else 'no' }}
{%     else %}
{{ key }} {{ item }}
{%     endif %}
{%   endfor %}
{% endfor %}
