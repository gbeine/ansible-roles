#
# {{ ansible_managed }}
#
# Overrides /etc/systemd/timesyncd.conf, see timesyncd.conf(5)
#

[Time]
NTP={{ bootstrap_debian__ntp_sources | selectattr('type', 'eq', 'server') | map(attribute='address') | join(' ') }}
FallbackNTP={{ bootstrap_debian__ntp_sources | selectattr('type', 'eq', 'pool') | map(attribute='address') | join(' ') }}
{% if bootstrap_debian__ntp_root_distance_max_sec is defined %}
RootDistanceMaxSec={{ bootstrap_debian__ntp_root_distance_max_sec }}
{% endif %}
{% if bootstrap_debian__ntp_poll_interval_min_sec is defined %}
PollIntervalMinSec={{ bootstrap_debian__ntp_poll_interval_min_sec }}
{% endif %}
{% if bootstrap_debian__ntp_poll_interval_max_sec is defined %}
PollIntervalMaxSec={{ bootstrap_debian__ntp_poll_interval_max_sec }}
{% endif %}
{% if bootstrap_debian__ntp_connection_retry_sec is defined %}
ConnectionRetrySec={{ bootstrap_debian__ntp_connection_retry_sec }}
{% endif %}
{% if bootstrap_debian__ntp_save_interval_sec is defined %}
SaveIntervalSec={{ bootstrap_debian__ntp_save_interval_sec }}
{% endif %}
