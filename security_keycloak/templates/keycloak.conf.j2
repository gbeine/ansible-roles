# {{ ansible_managed }}
{% for key, value in security_keycloak__conf_options | dictsort if value is not none %}
{%   set items = [] %}
{%   for item in (value if (value is sequence and value is not string) else [ value ]) %}
{%     set _ = items.append(((item | string | lower) if item is boolean else (item | string)) | replace('\\', '\\\\')) %}
{%   endfor %}
{{ key }}={{ items | join(',') }}
{% endfor %}
