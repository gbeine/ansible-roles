{#
  The values of the attributes as values of the Icinga DSL: strings are quoted, numbers and booleans are literals,
  lists are arrays and dictionaries are dictionaries with quoted keys, both in one line
#}
{% macro value(v) -%}
{%-   if v is boolean -%}
{{ v | ternary('true', 'false') }}
{%-   elif v is number -%}
{{ v }}
{%-   elif v is string -%}
"{{ v | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%-   elif v is mapping -%}
{ {% for k, item in v.items() if item is not none %}"{{ k | replace('\\', '\\\\') | replace('"', '\\"') }}" = {{ value(item) }}{{ ', ' if not loop.last }}{% endfor %} }
{%-   else -%}
[ {% for item in v %}{{ value(item) }}{{ ', ' if not loop.last }}{% endfor %} ]
{%-   endif -%}
{%- endmacro %}
{% set feature = monitoring_icinga_master__features[monitoring_icinga_master__feature] %}
{% set attributes = monitoring_icinga_master__config[monitoring_icinga_master__feature] %}
{% set booleans = monitoring_icinga_master__config_booleans[monitoring_icinga_master__feature] | default([]) %}

object {{ feature.type }} "{{ feature.name }}" {
{% for key, v in attributes.items() if v is not none and (v is not false or key in booleans) %}
  {{ key }} = {{ value(v) }}
{% endfor %}
{% for target, constant in monitoring_icinga_master__secret_constants.items() if target.startswith(monitoring_icinga_master__feature ~ '.') %}
  {{ target.split('.', 1)[1] }} = {{ constant }}
{% endfor %}
}
