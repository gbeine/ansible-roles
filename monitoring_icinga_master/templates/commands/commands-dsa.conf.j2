/*
 * commands-dsa.conf
 * CheckCommands for the DSA check plugins from monitoring-plugins-contrib
 */

object CheckCommand "dsa-cert-expire" {
  command = [ PluginContribDir + "/check_cert_expire" ]

  arguments = {
    "-w" = {
      value = "$dsa_cert_warn$"
      description = "Warn if the certificate expires in less than N seconds (plugin default: 1209600 = 14 days)"
    }
    "-c" = {
      value = "$dsa_cert_crit$"
      description = "Critical if the certificate expires in less than N seconds (plugin default: 86400 = 1 day)"
    }
    "certfile" = {
      value = "$dsa_cert_file$"
      skip_key = true
      required = true
      order = 99
      description = "Path to the certificate file"
    }
  }
}

object CheckCommand "dsa-cert-expire-dir" {
  command = [ PluginContribDir + "/check_cert_expire_dir" ]

  arguments = {
    "directory" = {
      value = "$dsa_cert_dir$"
      skip_key = true
      required = true
      description = "Directory whose *.crt files are checked"
    }
  }
}

object CheckCommand "dsa-dnssec-delegation" {
  command = [ PluginContribDir + "/check_dnssec_delegation" ]

  arguments = {
    "--dir" = {
      value = "$dsa_dnssec_dirs$"
      repeat_key = true
      order = 1
      description = "Directory or directories containing zone files (array allowed)"
    }
    "--dlv" = {
      value = "$dsa_dnssec_dlv$"
      order = 2
      description = "Alternative DLV zone"
    }
    "--verbose" = {
      set_if = "$dsa_dnssec_verbose$"
      order = 3
    }
    "mode" = {
      value = "$dsa_dnssec_mode$"
      skip_key = true
      required = true
      order = 10
      description = "overview | check-dlv | check-ds | check-header"
    }
    "zones" = {
      value = "$dsa_dnssec_zones$"
      skip_key = true
      order = 11
      description = "Zones to check (array); if omitted, zones are taken from --dir"
    }
  }

  vars.dsa_dnssec_mode = "check-ds"
}

object CheckCommand "dsa-entropy" {
  command = [ PluginContribDir + "/check_entropy" ]

  arguments = {
    "-r" = {
      value = "$dsa_entropy_retries$"
      description = "Maximum number of retries (plugin default: 10)"
    }
    "-s" = {
      value = "$dsa_entropy_sleep$"
      description = "Time to wait between reads in ms (plugin default: 250)"
    }
    "-w" = {
      value = "$dsa_entropy_watermark$"
      description = "Minimum number of bytes expected in the entropy pool (plugin default: 800)"
    }
  }
}

object CheckCommand "dsa-packages" {
  command = [ PluginContribDir + "/check_packages" ]

  arguments = {
    "ignorefiles" = {
      value = "$dsa_packages_ignorefiles$"
      skip_key = true
      description = "Optional: ignore files/directories (array). Plugin default: /etc/nagios/obsolete-packages-ignore and /etc/nagios/obsolete-packages-ignore.d"
    }
  }
}

object CheckCommand "dsa-running-kernel" {
  command = [ PluginContribDir + "/check_running_kernel" ]
  // no arguments
}

object CheckCommand "dsa-soas" {
  command = [ PluginContribDir + "/check_soas" ]

  arguments = {
    "-a" = {
      value = "$dsa_soas_additional_ns$"
      repeat_key = true
      order = 1
      description = "Additional nameservers to query (array allowed)"
    }
    "-n" = {
      set_if = "$dsa_soas_no_soa_ns$"
      order = 2
      description = "Do not look up nameservers via NS records (requires at least two -a)"
    }
    "-v" = {
      set_if = "$dsa_soas_verbose$"
      order = 3
    }
    "domains" = {
      value = "$dsa_soas_domains$"
      skip_key = true
      required = true
      order = 99
      description = "Domains to check (array)"
    }
  }
}

object CheckCommand "dsa-statusfile" {
  command = [ PluginContribDir + "/check_statusfile" ]

  arguments = {
    "-a" = {
      value = "$dsa_statusfile_age$"
      description = "Maximum age, e.g. 3600, 90m, 26h, 2d (plugin default: 26h)"
    }
    "statusfile" = {
      value = "$dsa_statusfile_path$"
      skip_key = true
      required = true
      order = 99
      description = "Status file; first line is OK/WARNING/CRITICAL/UNKNOWN, followed by the check output"
    }
  }
}
