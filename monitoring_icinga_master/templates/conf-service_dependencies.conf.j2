/*
 *
 * {{ ansible_managed }}
 *
 */

{% for dependency in monitoring_icinga_master__service_dependencies %}
{%   if dependency.apply is defined %}
apply Dependency "{{ dependency.apply }}" to Service {
{%     if dependency.parent_host_name is defined %}
  parent_host_name = "{{ dependency.parent_host_name }}"
{%     endif %}
  parent_service_name = "{{ dependency.parent_service_name }}"
{%     if dependency.disable_checks is defined %}
  disable_checks = {{ dependency.disable_checks | ternary('true', 'false') }}
{%     endif %}
{%     for assign in dependency.assign | default([]) %}
  assign where {{ assign }}
{%     endfor %}
{%     for ignore in dependency.ignore | default([]) %}
  ignore where {{ ignore }}
{%     endfor %}
}
{%   else %}
object Dependency "{{ dependency.child_service_name }}-{{ dependency.child_host_name }}-{{ dependency.parent_host_name }}" {
  parent_host_name = "{{ dependency.parent_host_name }}"
  parent_service_name = "{{ dependency.parent_service_name }}"
  child_host_name = "{{ dependency.child_host_name }}"
  child_service_name = "{{ dependency.child_service_name }}"
{%     if dependency.disable_checks is defined %}
  disable_checks = {{ dependency.disable_checks | ternary('true', 'false') }}
{%     endif %}
}
{%   endif %}

{% endfor %}
