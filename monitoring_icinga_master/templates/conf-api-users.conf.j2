{% for user in monitoring_icinga_master__api_users %}
object ApiUser "{{ user.name }}" {
{%   if ('api_users.' ~ user.name ~ '.password') in monitoring_icinga_master__secret_constants %}
  password = {{ monitoring_icinga_master__secret_constants['api_users.' ~ user.name ~ '.password'] }}
{%   endif %}
  permissions = [ {{ '"' if user.permissions | default([]) | length > 0 }}{{ user.permissions | default([]) | join('", "') }}{{ '"' if user.permissions | default([]) | length > 0 }} ]
}

{% endfor %}
