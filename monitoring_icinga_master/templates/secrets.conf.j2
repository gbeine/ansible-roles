/*
 *
 * {{ ansible_managed }}
 *
 * The secrets of {{ monitoring_icinga_master__container.name }} as constants, strings of Icinga escape \ and "
 *
 */

{% for secret in monitoring_icinga_master__secrets %}
const Secret_{{ secret.name }} = "{{ secret.data | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
