#
# {{ ansible_managed }}
#
# Read by mongod with --config, the options of the role merged with mongodb_config
#
{% macro render(options, indent) %}
{%   for key, value in options.items() if value is not none %}
{%     if value is mapping and value | length > 0 %}
{{ indent }}{{ key }}:
{{ render(value, indent ~ '  ') -}}
{%     elif value is not mapping %}
{{ indent }}{{ key }}: {{ value | to_json }}
{%     endif %}
{%   endfor %}
{% endmacro %}
{{ render(database_mongodb__config | combine(database_mongodb__config_role, recursive=true), '') -}}
