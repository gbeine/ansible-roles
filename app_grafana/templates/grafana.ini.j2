{%- macro value(v) -%}
{%-   set items = [] -%}
{%-   for item in (v if (v is sequence and v is not string) else [ v ]) -%}
{%-     set _ = items.append((item | string | lower) if item is boolean else (item | string)) -%}
{%-   endfor -%}
{%-   set text = items | join(',') -%}
{#- go-ini cuts inline comments and trims values, such values are quoted -#}
{{ ('"""' ~ text ~ '"""') if (text is search('\\s[#;]') or text is match('^[#;\\s"]') or text is search('\\s$')) else text }}
{%- endmacro -%}
# {{ ansible_managed }}
{% for key, v in app_grafana__ini | dictsort if v is not mapping and v is not none %}
{{ key }} = {{ value(v) }}
{% endfor %}
{% for section, options in app_grafana__ini | dictsort if options is mapping %}

[{{ section }}]
{%   for key, v in options | dictsort if v is not none %}
{{ key }} = {{ value(v) }}
{%   endfor %}
{% endfor %}
