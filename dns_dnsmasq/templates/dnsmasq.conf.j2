###
### {{ ansible_managed }}
###
{% for key, value in dns_dnsmasq__config | dictsort %}
{%   if value is boolean %}
{%     if value %}
{{ key }}
{%     endif %}
{%   else %}
{%     for item in (value if value is sequence and value is not string else [ value ]) %}
{{ key }}={{ item }}
{%     endfor %}
{%   endif %}
{% endfor %}
