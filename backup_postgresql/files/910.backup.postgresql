#!/bin/bash
#
# backup.postgresql - Backup PostgreSQL databases
#
# (c) 2011-2025 Gerrit Beine
#
umask 022

if [ -z ${daily_backup_running} ]; then
    echo "$0 not called from within backup script"
    exit
fi

if [ -r /etc/backup/postgresql ]; then
    . /etc/backup/postgresql
fi

: ${daily_backup_postgresql_enable="NO"}
: ${daily_backup_postgresql_backup_dir="/var/backups/postgresql"}
: ${daily_backup_postgresql_user="postgres"}
: ${daily_backup_postgresql_ignore_databases="template0 template1"}
: ${daily_backup_postgresql_keep_days="-14days"}
: ${daily_backup_postgresql_podman_container="postgresql"}
: ${daily_backup_postgresql_podman_backup_dir="/backup"}

postgresql_podman="podman exec ${daily_backup_postgresql_podman_container}"
postgresql_show="psql -U ${daily_backup_postgresql_user}"
postgresql_dump="pg_dump -U ${daily_backup_postgresql_user}"
postgresql_dump_options="--format=directory"
find="/usr/bin/find"
find_cleanup_options="-type f -not -newermt ${daily_backup_postgresql_keep_days} -delete"

today=`date +%Y%m%d`

rc=0
case "${daily_backup_postgresql_enable}" in
	[Yy][Ee][Ss])
		echo
		echo "Backup PostgreSQL databases"

		mkdir -p ${daily_backup_postgresql_backup_dir} || true

		for db in `${postgresql_podman} ${postgresql_show} -c 'SELECT datname FROM pg_database;'`; do
			if [[ "datname" == "${db}" ]]; then
				continue
			fi
			if [[ "${db}" =~ ^-----------.*$ ]]; then
				continue
			fi
			if [[ "${db}" =~ ^\(|\)$ ]]; then
				continue
			fi
			if [[ " ${daily_backup_postgresql_ignore_databases[@]} " =~ " ${db} " ]]; then
				continue
			fi

			${postgresql_podman} ${postgresql_dump} ${postgresql_dump_options} --file=${daily_backup_postgresql_podman_backup_dir}/${db}-${today} ${db}
		done

		${find} ${daily_backup_postgresql_backup_dir} ${find_cleanup_options}
		${find} ${daily_backup_postgresql_backup_dir} -empty -type d -delete
		;;
esac

exit "${rc}"
