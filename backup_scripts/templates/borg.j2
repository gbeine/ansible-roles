###
### {{ ansible_managed }}
###

daily_backup_borg_enable="YES"
daily_backup_borg_repository="{{ backup_scripts__borg.repository }}"
daily_backup_borg_archive="{{ backup_scripts__borg.archive }}"
daily_backup_borg_rsh="{{ backup_scripts__borg.rsh }}"
{% if backup_scripts__borg.password is defined %}
daily_backup_borg_password_command="cat {{ backup_scripts__etc_dir }}/borg-password"
{% elif backup_scripts__borg.password_file is defined %}
daily_backup_borg_password_command="cat {{ backup_scripts__borg.password_file }}"
{% elif backup_scripts__borg.password_command is defined %}
daily_backup_borg_password_command="{{ backup_scripts__borg.password_command }}"
{% endif %}
daily_backup_borg_cache_dir="{{ backup_scripts__borg.cache_dir }}"
daily_backup_borg_options="{{ backup_scripts__borg.options }}"
daily_backup_borg_include="{{ backup_scripts__etc_dir }}/borg-includes"
daily_backup_borg_exclude="{{ backup_scripts__etc_dir }}/borg-excludes"
