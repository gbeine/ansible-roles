###
### {{ ansible_managed }}
###

daily_backup_restic_enable="YES"
daily_backup_restic_repository="{{ backup_scripts__restic.repository }}"
daily_backup_restic_backend="{{ backup_scripts__restic.backend | upper }}"
{% if backup_scripts__restic.backend == 'sftp' %}
daily_backup_restic_sftp_command="ssh -F {{ backup_scripts__etc_dir }}/restic-sftp backup -s sftp"
{% endif %}
daily_backup_restic_pass_enable="{{ backup_scripts__restic.pass_enable | ternary('YES', 'NO') }}"
daily_backup_restic_pass_command="{{ backup_scripts__restic.pass_command }}"
{% if backup_scripts__restic.password is defined %}
daily_backup_restic_password_file="{{ backup_scripts__etc_dir }}/restic-password"
{% elif backup_scripts__restic.password_file is defined %}
daily_backup_restic_password_file="{{ backup_scripts__restic.password_file }}"
{% elif backup_scripts__restic.password_command is defined %}
daily_backup_restic_password_command="{{ backup_scripts__restic.password_command }}"
{% endif %}
daily_backup_restic_cache_dir="{{ backup_scripts__restic.cache_dir }}"
daily_backup_restic_options="{{ backup_scripts__restic.options }}"
daily_backup_restic_include="{{ backup_scripts__etc_dir }}/restic-includes"
daily_backup_restic_exclude="{{ backup_scripts__etc_dir }}/restic-excludes"
