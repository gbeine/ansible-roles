###
### {{ ansible_managed }}
###
{% set name = backup_scripts__script.name %}

daily_backup_{{ name }}_enable="YES"
daily_backup_{{ name }}_podman_container="{{ backup_scripts__database.container }}"
daily_backup_{{ name }}_host="{{ backup_scripts__database.host }}"
daily_backup_{{ name }}_user="{{ backup_scripts__database.user }}"
{% if backup_scripts__database.password is defined %}
daily_backup_{{ name }}_password_file="{{ backup_scripts__etc_dir }}/{{ name }}-password"
{% elif backup_scripts__database.password_file is defined %}
daily_backup_{{ name }}_password_file="{{ backup_scripts__database.password_file }}"
{% elif backup_scripts__database.password_command is defined %}
daily_backup_{{ name }}_password_command="{{ backup_scripts__database.password_command }}"
{% endif %}
daily_backup_{{ name }}_backup_dir="{{ backup_scripts__database.backup_dir }}"
daily_backup_{{ name }}_dump_options="{{ backup_scripts__database.options }}"
daily_backup_{{ name }}_ignore_databases="{{ backup_scripts__database.ignore_databases | join(' ') }}"
daily_backup_{{ name }}_keep_days="{{ backup_scripts__database.keep_days }}"
daily_backup_{{ name }}_compress="{{ backup_scripts__database.compress | ternary('YES', 'NO') }}"
daily_backup_{{ name }}_replication="{{ backup_scripts__database.replication | ternary('YES', 'NO') }}"
